# =============================================================================
# Contoh konfigurasi Smart Zone Trading Bot Backend
# Salin berkas ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah meng-commit berkas .env berisi rahasia ke git!
# =============================================================================

# --- Keamanan (WAJIB diisi; aplikasi menolak start jika kosong) -------------
# Secret yang sama persis dengan field "secret" pada alert Pine Script.
# Gunakan string acak panjang, mis. hasil: openssl rand -hex 32
WEBHOOK_SECRET=ganti-dengan-secret-acak-panjang

# Token untuk endpoint admin (header X-Admin-Token). Buat yang berbeda
# dari WEBHOOK_SECRET.
ADMIN_TOKEN=ganti-dengan-token-admin-acak

# --- Telegram (opsional; kosongkan untuk menonaktifkan notifikasi) ----------
# Token bot dari @BotFather, format: 123456789:AAF...
TELEGRAM_BOT_TOKEN=
# ID chat/grup tujuan notifikasi (bisa didapat dari @userinfobot).
TELEGRAM_CHAT_ID=
# Kirim notifikasi juga saat sinyal DITOLAK (true/false).
TELEGRAM_NOTIFY_REJECTED=false
# Kirim notifikasi untuk alert informasi ZONE_TOUCH (true/false).
TELEGRAM_NOTIFY_ZONE_TOUCH=false

# --- Mode trading ------------------------------------------------------------
# paper       = simulasi penuh (disarankan; default)
# signal_only = hanya catat & notifikasi, tanpa buku besar paper
# live        = template live trading (butuh ENABLE_LIVE_TRADING=true + ccxt)
TRADING_MODE=paper
# Sakelar pengaman ekstra untuk live trading. Biarkan false sampai Anda
# benar-benar paham risikonya dan sudah puas dengan hasil paper trading.
ENABLE_LIVE_TRADING=false
# Identitas exchange ccxt (mis. binance) + kredensial API.
# PENTING: nonaktifkan izin WITHDRAW pada API key, dan jangan bagikan key.
EXCHANGE_ID=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Paper trading & manajemen risiko ---------------------------------------
# Saldo awal simulasi (dalam mata uang quote, mis. USDT).
PAPER_START_BALANCE=10000
# Persen saldo yang dipertaruhkan per posisi (1.0 = 1%).
RISK_PER_TRADE_PCT=1.0
# Risk/Reward minimum hasil HITUNG ULANG server; di bawah ini sinyal ditolak.
MIN_RISK_REWARD=1.5
# Maksimum sinyal DITERIMA per hari (hari UTC).
MAX_SIGNALS_PER_DAY=10
# Jika total rugi paper yang ditutup hari ini melebihi persen ini dari saldo,
# sinyal baru ditolak sampai hari UTC berikutnya.
MAX_DAILY_LOSS_PCT=3.0

# --- Filter sinyal ------------------------------------------------------------
# Jendela deduplikasi: sinyal diterima dengan simbol+arah+timeframe sama
# dalam rentang detik ini akan ditolak (409).
DEDUP_WINDOW_SECONDS=300
# Umur maksimum sinyal berdasarkan field "time" payload (detik; 0 = nonaktif).
SIGNAL_MAX_AGE_SECONDS=300
# Daftar simbol yang diizinkan, dipisah koma (kosong = semua simbol).
# Contoh: BTCUSDT,ETHUSDT
SYMBOL_ALLOWLIST=

# --- Jaringan -----------------------------------------------------------------
# Daftar IP pengirim yang diizinkan, dipisah koma (kosong = semua IP).
# IP resmi webhook TradingView dapat dilihat di dokumentasi TradingView.
IP_ALLOWLIST=
# Set true HANYA jika aplikasi berada di belakang reverse proxy tepercaya
# yang menimpa header X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Batas request per menit per IP (sliding window di memori).
RATE_LIMIT_PER_MINUTE=30

# --- Lain-lain -----------------------------------------------------------------
# URL database SQLAlchemy. Default: berkas SQLite lokal (cocok untuk lokal/VPS).
# Untuk deploy SERVERLESS (Vercel), SQLite TIDAK bisa dipakai — gunakan Postgres
# serverless (Vercel Postgres/Neon/Supabase), contoh:
#   DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Skema postgres:// / postgresql:// otomatis dinormalkan ke driver psycopg.
DATABASE_URL=sqlite:///./szt_signals.db
# Level log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
