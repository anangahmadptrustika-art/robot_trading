//@version=6
// =============================================================================
//  SMART ZONE TRADING BOT [SZT] — MODE STRATEGY / BACKTEST — v1.0
// -----------------------------------------------------------------------------
//  Versi Strategy Tester dari indikator "Smart Zone Trading Bot".
//  Logika sinyal 100% sama dengan file indicator (anti-repaint):
//    • Sinyal dihitung pada CLOSE candle → order dieksekusi di OPEN bar
//      berikutnya (realistis, tanpa data masa depan).
//    • Pivot butuh konfirmasi `pivotLen` bar; BOS diukur dengan harga close
//      terhadap pivot yang sudah terkonfirmasi.
//  Tambahan khusus strategy:
//    • Position sizing: risiko % dari equity / modal tetap.
//    • TP1 parsial + TP2, break-even opsional, trailing stop opsional.
//    • Batas loss harian & batas sinyal harian.
//    • Statistik live di panel: winrate, profit factor, expectancy.
//
//  Commission & slippage default: 0.05% + 2 tick — sesuaikan dengan broker
//  Anda lewat tab Properties di Strategy Tester.
//
//  DISCLAIMER: Hasil backtest tidak menjamin hasil di masa depan. Gunakan
//  untuk memvalidasi & membuang strategi jelek, bukan untuk janji profit.
// =============================================================================
strategy("Smart Zone Trading Bot [SZT] — Strategy", "SZT Strategy v1", overlay = true, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, pyramiding = 0, calc_on_every_tick = false, max_boxes_count = 100, max_lines_count = 100, max_labels_count = 100)

// =============================================================================
//  1. INPUT
// =============================================================================
G_MASTER = "⚙️  Master"
G_STRUCT = "🏗️  Market Structure"
G_TREND  = "📈  Filter Trend"
G_ZONE   = "🎯  Zona Entry"
G_ENTRY  = "✅  Validasi Entry"
G_RISK   = "🛡️  Risk & Money Management"
G_EXIT   = "🚪  Manajemen Exit"
G_MTF    = "🕐  Multi-Timeframe & Sesi"
G_BT     = "🧪  Rentang Backtest"
G_VIS    = "🎨  Tampilan"

// --- Master ------------------------------------------------------------------
masterEnable  = input.bool(true,  "Bot aktif (kill switch)", group = G_MASTER)
enableBuy     = input.bool(true,  "Aktifkan sinyal BUY",  group = G_MASTER)
enableSell    = input.bool(true,  "Aktifkan sinyal SELL", group = G_MASTER)

// --- Market structure -----------------------------------------------------------
pivotLen      = input.int(5,   "Panjang pivot (kiri & kanan)", minval = 2, maxval = 20, group = G_STRUCT)
obLookback    = input.int(15,  "Lookback order block", minval = 3, maxval = 50, group = G_STRUCT)
maxZones      = input.int(6,   "Maksimal zona per sisi", minval = 1, maxval = 15, group = G_STRUCT)

// --- Filter trend ------------------------------------------------------------------
emaFastLen    = input.int(50,   "EMA cepat",  minval = 5,  group = G_TREND)
emaSlowLen    = input.int(200,  "EMA lambat", minval = 20, group = G_TREND)
atrLen        = input.int(14,   "Periode ATR", minval = 1, group = G_TREND)
flatBars      = input.int(10,   "Bar pengukur kemiringan EMA", minval = 3, group = G_TREND)
flatThreshAtr = input.float(0.4, "Ambang EMA datar (x ATR)", minval = 0.0, step = 0.1, group = G_TREND)
useVolFilter  = input.bool(true,  "Filter volume (vol > MA volume)", group = G_TREND)
volMaLen      = input.int(20,  "Periode MA volume", minval = 1, group = G_TREND)
useRsiFilter  = input.bool(false, "Filter RSI overbought/oversold", group = G_TREND)
rsiLen        = input.int(14, "Periode RSI", minval = 2, group = G_TREND)
rsiOb         = input.float(70, "RSI overbought", minval = 50, maxval = 100, group = G_TREND)
rsiOs         = input.float(30, "RSI oversold",  minval = 0,  maxval = 50,  group = G_TREND)

// --- Zona entry ------------------------------------------------------------------------
usePremDisc   = input.bool(true, "Pakai premium/discount sebagai confluence", group = G_ZONE)
allowRange    = input.bool(false, "Izinkan range trading saat sideways", group = G_ZONE)

// --- Validasi entry ----------------------------------------------------------------------
slMode        = input.string("Swing + Buffer ATR", "Mode stop loss", options = ["Swing + Buffer ATR", "ATR Murni"], group = G_ENTRY)
swingBufAtr   = input.float(0.3, "Buffer SL di bawah/atas swing (x ATR)", minval = 0.0, step = 0.1, group = G_ENTRY)
slAtrMult     = input.float(1.5, "Jarak SL mode ATR murni (x ATR)", minval = 0.1, step = 0.1, group = G_ENTRY)
maxSlAtrMult  = input.float(3.0, "SL maksimal (x ATR)", minval = 0.5, step = 0.1, group = G_ENTRY)
tp1RR         = input.float(1.5, "TP1 (x risiko)", minval = 0.5, step = 0.1, group = G_ENTRY)
tp2RR         = input.float(2.0, "TP2 (x risiko)", minval = 1.0, step = 0.1, group = G_ENTRY)
minRR         = input.float(2.0, "Minimal RR ke struktur berlawanan", minval = 0.5, step = 0.1, group = G_ENTRY)
minAtrPct     = input.float(0.01, "ATR minimal (% dari harga)", minval = 0.0, step = 0.01, group = G_ENTRY)
maxCandleAtr  = input.float(2.5, "Candle sinyal maksimal (x ATR)", minval = 0.5, step = 0.1, group = G_ENTRY)
lateAtrMult   = input.float(1.0, "Jarak close maksimal dari zona (x ATR)", minval = 0.1, step = 0.1, group = G_ENTRY)

// --- Risk & money management ---------------------------------------------------------------
riskBasis     = input.string("Equity berjalan", "Dasar perhitungan risiko", options = ["Equity berjalan", "Modal awal tetap"], group = G_RISK, tooltip = "Equity berjalan = compounding. Modal awal tetap = ukuran risiko konstan.")
capital       = input.float(10000, "Modal (untuk mode 'Modal awal tetap')", minval = 1, group = G_RISK)
riskPct       = input.float(1.0, "Risiko per trade (%)", minval = 0.05, maxval = 5, step = 0.05, group = G_RISK)
maxLeverage   = input.float(1.0, "Nilai posisi maks (x equity)", minval = 0.1, step = 0.1, group = G_RISK, tooltip = "Membatasi ukuran posisi saat SL sangat ketat. 1 = tanpa leverage.")
maxSignalsDay = input.int(5, "Maksimal sinyal per hari", minval = 1, maxval = 50, group = G_RISK)
maxDailyLoss  = input.float(3.0, "Maksimal loss harian (% equity)", minval = 0.5, step = 0.5, group = G_RISK, tooltip = "Jika equity hari ini turun melebihi batas ini, tidak ada entry baru sampai besok.")
cooldownBars  = input.int(5, "Jeda minimal antar sinyal (bar)", minval = 0, group = G_RISK)
tradeProfile  = input.string("Balanced", "Profil trading", options = ["Conservative", "Balanced", "Aggressive"], group = G_RISK)

// --- Manajemen exit -----------------------------------------------------------------------------
tp1QtyPct     = input.float(50, "Porsi ditutup di TP1 (%)", minval = 10, maxval = 90, step = 5, group = G_EXIT)
useBE         = input.bool(true, "Break-even setelah trigger", group = G_EXIT)
beTriggerRR   = input.float(1.0, "Trigger break-even (x risiko)", minval = 0.3, step = 0.1, group = G_EXIT)
useTrail      = input.bool(false, "Trailing stop setelah TP1", group = G_EXIT)
trailAtrMult  = input.float(2.0, "Jarak trailing (x ATR)", minval = 0.5, step = 0.1, group = G_EXIT)

// --- MTF & sesi -----------------------------------------------------------------------------------
useMtf        = input.bool(false, "Konfirmasi multi-timeframe", group = G_MTF)
mtfTf         = input.timeframe("240", "Timeframe konfirmasi", group = G_MTF)
useSession    = input.bool(false, "Filter sesi trading", group = G_MTF)
sessionStr    = input.session("0700-2100", "Sesi aktif", group = G_MTF)
sessionTz     = input.string("", "Timezone sesi (kosong = timezone exchange)", group = G_MTF)

// --- Rentang backtest ---------------------------------------------------------------------------------
startTime     = input.time(timestamp("1 Jan 2020 00:00 +0000"), "Mulai backtest",   group = G_BT)
endTime       = input.time(timestamp("1 Jan 2030 00:00 +0000"), "Selesai backtest", group = G_BT)

// --- Tampilan -------------------------------------------------------------------------------------------
showZones     = input.bool(true, "Tampilkan zona entry", group = G_VIS)
showStruct    = input.bool(true, "Tampilkan BOS/CHoCH",  group = G_VIS)
showEmas      = input.bool(true, "Tampilkan EMA 50 & 200", group = G_VIS)
showPanel     = input.bool(true, "Tampilkan panel statistik", group = G_VIS)
panelPosInp   = input.string("Kanan Atas", "Posisi panel", options = ["Kanan Atas", "Kanan Bawah", "Kiri Atas", "Kiri Bawah"], group = G_VIS)
colBull       = input.color(#089981, "Warna bullish", group = G_VIS)
colBear       = input.color(#f23645, "Warna bearish", group = G_VIS)
webhookSecret = input.string("", "Webhook secret (untuk alert order)", group = G_MASTER, tooltip = "Disisipkan ke pesan alert order sebagai field \"secret\".")

// =============================================================================
//  2. TIPE DATA & VARIABEL GLOBAL
// =============================================================================
type Zone
    box   bx
    float top
    float bot
    bool  active
    bool  used

var demandZones  = array.new<Zone>()
var supplyZones  = array.new<Zone>()
var structLines  = array.new<line>()
var structLabels = array.new<label>()

var float lastSwingHigh    = na
var float prevSwingHigh    = na
var int   lastSwingHighBar = na
var float lastSwingLow     = na
var float prevSwingLow     = na
var int   lastSwingLowBar  = na
var bool  highTaken        = false
var bool  lowTaken         = false
var int   structTrend      = 0
var int   barsSinceBreakUp = 9999
var int   barsSinceBreakDn = 9999

// Manajemen posisi strategy
var int    trDir        = 0      // 1 long, -1 short, 0 flat/tidak ada
var float  trEntry      = na     // harga sinyal (basis level SL/TP)
var float  trSL         = na     // SL berjalan (bisa naik karena BE/trailing)
var float  trTP1        = na
var float  trTP2        = na
var float  trRisk       = na
var bool   tp1Hit       = false
var int    signalsToday  = 0
var int    lastSignalBar = -99999
var float  dayStartEquity = na

// =============================================================================
//  3. KALKULASI SERIES (scope global — konsisten & anti-repaint)
// =============================================================================
atrVal  = ta.atr(atrLen)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
volMa   = ta.sma(volume, volMaLen)
rsiVal  = ta.rsi(close, rsiLen)
ph      = ta.pivothigh(high, pivotLen, pivotLen)
pl      = ta.pivotlow(low, pivotLen, pivotLen)
newDay  = ta.change(time("D")) != 0

f_trendHtf() =>
    fastH = ta.ema(close, emaFastLen)
    slowH = ta.ema(close, emaSlowLen)
    fastH[1] > slowH[1] ? 1 : fastH[1] < slowH[1] ? -1 : 0
mtfTrendRaw = request.security(syminfo.tickerid, mtfTf, f_trendHtf(), lookahead = barmerge.lookahead_on)
mtfTrend    = useMtf ? mtfTrendRaw : 0

sessTz    = sessionTz == "" ? syminfo.timezone : sessionTz
inSession = not useSession or not na(time(timeframe.period, sessionStr, sessTz))
inDateRange = time >= startTime and time <= endTime

emaFlat   = math.abs(emaFast - emaFast[flatBars]) < flatThreshAtr * atrVal
emaTrendD = emaFast > emaSlow ? 1 : emaFast < emaSlow ? -1 : 0
trendDir  = emaFlat ? 0 : structTrend == 1 and emaTrendD == 1 ? 1 : structTrend == -1 and emaTrendD == -1 ? -1 : 0
trendText = trendDir == 1 ? "BULLISH" : trendDir == -1 ? "BEARISH" : "SIDEWAYS"

eqLevel = (nz(lastSwingHigh, high) + nz(lastSwingLow, low)) / 2

rng             = high - low
bullBody        = close > open
bearBody        = close < open
strongCloseBull = rng > 0 and (close - low) / rng >= 0.65
strongCloseBear = rng > 0 and (high - close) / rng >= 0.65
wickBull        = rng > 0 and (math.min(open, close) - low) / rng >= 0.4
wickBear        = rng > 0 and (high - math.max(open, close)) / rng >= 0.4
engulfBull      = bullBody and close[1] < open[1] and close >= open[1] and open <= close[1]
engulfBear      = bearBody and close[1] > open[1] and close <= open[1] and open >= close[1]
confirmBull     = bullBody and (strongCloseBull or wickBull or engulfBull)
confirmBear     = bearBody and (strongCloseBear or wickBear or engulfBear)

atrPctVal = close > 0 ? atrVal / close * 100 : 0.0
atrOk     = atrPctVal >= minAtrPct
candleOk  = rng <= maxCandleAtr * atrVal
volOk     = not useVolFilter or na(volume) or volume > volMa
confThreshold = tradeProfile == "Conservative" ? 75 : tradeProfile == "Balanced" ? 60 : 45

// =============================================================================
//  4. FUNGSI BANTU
// =============================================================================
f_pushLine(array<line> arr, line ln, int cap) =>
    array.push(arr, ln)
    if array.size(arr) > cap
        line.delete(array.shift(arr))

f_pushLabel(array<label> arr, label lb, int cap) =>
    array.push(arr, lb)
    if array.size(arr) > cap
        label.delete(array.shift(arr))

f_overlaps(array<Zone> zArr, float top, float bot) =>
    bool res = false
    if array.size(zArr) > 0
        for i = 0 to array.size(zArr) - 1
            Zone z = array.get(zArr, i)
            if z.active and not (bot > z.top or top < z.bot)
                res := true
                break
    res

f_makeZone(array<Zone> zArr, float top, float bot, int srcBar, bool isDemand) =>
    color hidden = color.new(color.gray, 100)
    color bg  = isDemand ? color.new(colBull, 85) : color.new(colBear, 85)
    color brd = isDemand ? color.new(colBull, 55) : color.new(colBear, 55)
    box bx = box.new(srcBar, top, bar_index + 3, bot, border_color = showZones ? brd : hidden, border_width = 1, bgcolor = showZones ? bg : hidden)
    array.push(zArr, Zone.new(bx, top, bot, true, false))
    if array.size(zArr) > maxZones
        Zone old = array.shift(zArr)
        box.delete(old.bx)

f_findDemand() =>
    Zone res = na
    int n = array.size(demandZones)
    if n > 0
        for i = n - 1 to 0
            Zone z = array.get(demandZones, i)
            if z.active and not z.used and low <= z.top and close >= z.bot
                res := z
                break
    res

f_findSupply() =>
    Zone res = na
    int n = array.size(supplyZones)
    if n > 0
        for i = n - 1 to 0
            Zone z = array.get(supplyZones, i)
            if z.active and not z.used and high >= z.bot and close <= z.top
                res := z
                break
    res

// Payload JSON untuk alert order strategy (semi-auto via webhook)
f_json(string _sig, float _entry, float _sl, float _tp1, float _tp2, float _rr, string _trend, int _conf, float _qty) =>
    string j = '{"symbol":"' + syminfo.ticker + '"'
    j += ',"timeframe":"' + timeframe.period + '"'
    j += ',"signal":"' + _sig + '"'
    j += ',"entry":"' + str.tostring(_entry, format.mintick) + '"'
    j += ',"stop_loss":"' + str.tostring(_sl, format.mintick) + '"'
    j += ',"take_profit_1":"' + str.tostring(_tp1, format.mintick) + '"'
    j += ',"take_profit_2":"' + str.tostring(_tp2, format.mintick) + '"'
    j += ',"risk_reward":"' + str.tostring(_rr, "#.##") + '"'
    j += ',"trend":"' + _trend + '"'
    j += ',"confidence":"' + str.tostring(_conf) + '"'
    j += ',"position_size":"' + str.tostring(_qty, "#.######") + '"'
    j += ',"time":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ssZ", "UTC") + '"'
    j += ',"strategy":"Smart Zone Trading Bot"'
    if webhookSecret != ""
        j += ',"secret":"' + webhookSecret + '"'
    j += "}"
    j

// =============================================================================
//  5. LOGIKA UTAMA — dievaluasi pada close bar (kalkulasi strategy standar)
// =============================================================================
if barstate.isconfirmed
    // ---- 5a. Reset harian & guard loss harian --------------------------------
    if newDay or na(dayStartEquity)
        dayStartEquity := strategy.equity
        signalsToday := 0

    // ---- 5b. Deteksi posisi sudah flat → bersihkan state ----------------------
    if trDir != 0 and strategy.position_size == 0 and bar_index > lastSignalBar
        trDir := 0
        tp1Hit := false
        trEntry := na
        trSL := na
        trTP1 := na
        trTP2 := na
        trRisk := na

    // ---- 5c. Registrasi pivot terkonfirmasi -----------------------------------
    if not na(ph)
        prevSwingHigh    := lastSwingHigh
        lastSwingHigh    := ph
        lastSwingHighBar := bar_index - pivotLen
        highTaken        := false
    if not na(pl)
        prevSwingLow    := lastSwingLow
        lastSwingLow    := pl
        lastSwingLowBar := bar_index - pivotLen
        lowTaken        := false

    // ---- 5d. BOS / CHoCH + pembuatan zona --------------------------------------
    bool breakUp = not na(lastSwingHigh) and not highTaken and close > lastSwingHigh
    bool breakDn = not na(lastSwingLow) and not lowTaken and close < lastSwingLow

    if breakUp
        highTaken := true
        bool isChoch = structTrend == -1
        structTrend := 1
        barsSinceBreakUp := 0
        if showStruct
            f_pushLine(structLines, line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color = color.new(colBull, 30), style = line.style_dashed), 10)
            f_pushLabel(structLabels, label.new(bar_index, lastSwingHigh, isChoch ? "CHoCH" : "BOS", style = label.style_label_down, color = color.new(colBull, 25), textcolor = color.white, size = size.tiny), 10)
        int obIdx = -1
        for i = 1 to obLookback
            if close[i] < open[i]
                obIdx := i
                break
        if obIdx > 0
            float zTop = math.max(open[obIdx], close[obIdx])
            float zBot = low[obIdx]
            if not f_overlaps(demandZones, zTop, zBot)
                f_makeZone(demandZones, zTop, zBot, bar_index - obIdx, true)

    if breakDn
        lowTaken := true
        bool isChoch = structTrend == 1
        structTrend := -1
        barsSinceBreakDn := 0
        if showStruct
            f_pushLine(structLines, line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color = color.new(colBear, 30), style = line.style_dashed), 10)
            f_pushLabel(structLabels, label.new(bar_index, lastSwingLow, isChoch ? "CHoCH" : "BOS", style = label.style_label_up, color = color.new(colBear, 25), textcolor = color.white, size = size.tiny), 10)
        int obIdx = -1
        for i = 1 to obLookback
            if close[i] > open[i]
                obIdx := i
                break
        if obIdx > 0
            float zTop = high[obIdx]
            float zBot = math.min(open[obIdx], close[obIdx])
            if not f_overlaps(supplyZones, zTop, zBot)
                f_makeZone(supplyZones, zTop, zBot, bar_index - obIdx, false)

    // ---- 5e. Kelola zona -----------------------------------------------------------
    if array.size(demandZones) > 0
        for i = array.size(demandZones) - 1 to 0
            Zone z = array.get(demandZones, i)
            if z.active
                box.set_right(z.bx, bar_index + 3)
                if close < z.bot
                    z.active := false
                    if showZones
                        box.set_bgcolor(z.bx, color.new(color.gray, 94))
                        box.set_border_color(z.bx, color.new(color.gray, 75))
    if array.size(supplyZones) > 0
        for i = array.size(supplyZones) - 1 to 0
            Zone z = array.get(supplyZones, i)
            if z.active
                box.set_right(z.bx, bar_index + 3)
                if close > z.top
                    z.active := false
                    if showZones
                        box.set_bgcolor(z.bx, color.new(color.gray, 94))
                        box.set_border_color(z.bx, color.new(color.gray, 75))

    // ---- 5f. Guard entry umum ---------------------------------------------------------
    float dailyPnlPct = na(dayStartEquity) or dayStartEquity == 0 ? 0.0 : (strategy.equity - dayStartEquity) / dayStartEquity * 100
    bool dailyLossOk = dailyPnlPct > -maxDailyLoss
    bool gateCommon = masterEnable and inDateRange and trDir == 0 and strategy.position_size == 0 and dailyLossOk and signalsToday < maxSignalsDay and bar_index - lastSignalBar >= cooldownBars and atrOk and candleOk and volOk and inSession

    // ================================ ENTRY LONG =====================================
    if gateCommon and enableBuy
        Zone zL = f_findDemand()
        bool trendOkL = trendDir == 1 or (allowRange and trendDir == 0 and close < eqLevel)
        bool rsiOkL   = not useRsiFilter or rsiVal < rsiOb
        bool mtfOkL   = not useMtf or mtfTrend == 1
        if not na(zL) and trendOkL and rsiOkL and mtfOkL and confirmBull and close <= zL.top + lateAtrMult * atrVal
            float entryL = close
            float slBaseL = zL.bot
            if not na(lastSwingLow) and lastSwingLow < zL.bot and zL.bot - lastSwingLow <= atrVal
                slBaseL := lastSwingLow
            float slL = slMode == "ATR Murni" ? entryL - slAtrMult * atrVal : slBaseL - swingBufAtr * atrVal
            float riskL = entryL - slL
            bool slOkL = riskL > 0 and riskL <= maxSlAtrMult * atrVal
            bool headroomL = na(lastSwingHigh) or lastSwingHigh <= entryL or (lastSwingHigh - entryL) >= minRR * riskL
            if slOkL and headroomL
                float sc = 0.0
                float scMax = 60.0
                sc += barsSinceBreakUp <= 10 ? 20 : barsSinceBreakUp <= 20 ? 10 : 0
                sc += engulfBull ? 20 : strongCloseBull ? 15 : 10
                sc += not na(volume) and volume > 1.5 * volMa ? 10 : 0
                sc += rsiVal < 60 ? 10 : 0
                if usePremDisc
                    scMax += 20
                    sc += close < eqLevel ? 20 : 0
                if useMtf
                    scMax += 20
                    sc += mtfTrend == 1 ? 20 : 0
                int confL = math.round(30 + 70 * sc / scMax)
                if confL >= confThreshold
                    // ---- Position sizing: risiko uang ÷ jarak SL ----
                    float basis = riskBasis == "Equity berjalan" ? strategy.equity : capital
                    float riskMoney = basis * riskPct / 100
                    float qtyL = riskMoney / riskL
                    qtyL := math.min(qtyL, strategy.equity * maxLeverage / close)
                    if qtyL > 0
                        zL.used := true
                        box.set_right(zL.bx, bar_index)
                        trDir := 1
                        trEntry := entryL
                        trSL := slL
                        trTP1 := entryL + tp1RR * riskL
                        trTP2 := entryL + tp2RR * riskL
                        trRisk := riskL
                        tp1Hit := false
                        signalsToday += 1
                        lastSignalBar := bar_index
                        strategy.entry("Long", strategy.long, qty = qtyL, alert_message = f_json("BUY", entryL, slL, trTP1, trTP2, tp2RR, trendText, confL, qtyL))

    // ================================ ENTRY SHORT ====================================
    if gateCommon and enableSell and trDir == 0
        Zone zS = f_findSupply()
        bool trendOkS = trendDir == -1 or (allowRange and trendDir == 0 and close > eqLevel)
        bool rsiOkS   = not useRsiFilter or rsiVal > rsiOs
        bool mtfOkS   = not useMtf or mtfTrend == -1
        if not na(zS) and trendOkS and rsiOkS and mtfOkS and confirmBear and close >= zS.bot - lateAtrMult * atrVal
            float entryS = close
            float slBaseS = zS.top
            if not na(lastSwingHigh) and lastSwingHigh > zS.top and lastSwingHigh - zS.top <= atrVal
                slBaseS := lastSwingHigh
            float slS = slMode == "ATR Murni" ? entryS + slAtrMult * atrVal : slBaseS + swingBufAtr * atrVal
            float riskS = slS - entryS
            bool slOkS = riskS > 0 and riskS <= maxSlAtrMult * atrVal
            bool headroomS = na(lastSwingLow) or lastSwingLow >= entryS or (entryS - lastSwingLow) >= minRR * riskS
            if slOkS and headroomS
                float sc = 0.0
                float scMax = 60.0
                sc += barsSinceBreakDn <= 10 ? 20 : barsSinceBreakDn <= 20 ? 10 : 0
                sc += engulfBear ? 20 : strongCloseBear ? 15 : 10
                sc += not na(volume) and volume > 1.5 * volMa ? 10 : 0
                sc += rsiVal > 40 ? 10 : 0
                if usePremDisc
                    scMax += 20
                    sc += close > eqLevel ? 20 : 0
                if useMtf
                    scMax += 20
                    sc += mtfTrend == -1 ? 20 : 0
                int confS = math.round(30 + 70 * sc / scMax)
                if confS >= confThreshold
                    float basis = riskBasis == "Equity berjalan" ? strategy.equity : capital
                    float riskMoney = basis * riskPct / 100
                    float qtyS = riskMoney / riskS
                    qtyS := math.min(qtyS, strategy.equity * maxLeverage / close)
                    if qtyS > 0
                        zS.used := true
                        box.set_right(zS.bx, bar_index)
                        trDir := -1
                        trEntry := entryS
                        trSL := slS
                        trTP1 := entryS - tp1RR * riskS
                        trTP2 := entryS - tp2RR * riskS
                        trRisk := riskS
                        tp1Hit := false
                        signalsToday += 1
                        lastSignalBar := bar_index
                        strategy.entry("Short", strategy.short, qty = qtyS, alert_message = f_json("SELL", entryS, slS, trTP1, trTP2, tp2RR, trendText, confS, qtyS))

    // ---- 5g. Manajemen exit: TP1 parsial, TP2, break-even, trailing --------------
    // Catatan: deteksi TP1 memakai high/low bar (limit order aslinya terisi
    // intrabar — pendekatan konservatif yang sama dengan mode indicator).
    if trDir == 1
        if strategy.position_size > 0
            if not tp1Hit and high >= trTP1
                tp1Hit := true
            if useBE and (tp1Hit or high >= trEntry + beTriggerRR * trRisk)
                trSL := math.max(trSL, trEntry)
            if useTrail and tp1Hit
                trSL := math.max(trSL, close - trailAtrMult * atrVal)
        strategy.exit("TP1-L", from_entry = "Long", qty_percent = tp1QtyPct, limit = trTP1, stop = trSL, comment_profit = "TP1", comment_loss = "SL")
        strategy.exit("TP2-L", from_entry = "Long", limit = trTP2, stop = trSL, comment_profit = "TP2", comment_loss = tp1Hit ? "BE/Trail" : "SL")
    else if trDir == -1
        if strategy.position_size < 0
            if not tp1Hit and low <= trTP1
                tp1Hit := true
            if useBE and (tp1Hit or low <= trEntry - beTriggerRR * trRisk)
                trSL := math.min(trSL, trEntry)
            if useTrail and tp1Hit
                trSL := math.min(trSL, close + trailAtrMult * atrVal)
        strategy.exit("TP1-S", from_entry = "Short", qty_percent = tp1QtyPct, limit = trTP1, stop = trSL, comment_profit = "TP1", comment_loss = "SL")
        strategy.exit("TP2-S", from_entry = "Short", limit = trTP2, stop = trSL, comment_profit = "TP2", comment_loss = tp1Hit ? "BE/Trail" : "SL")

// =============================================================================
//  6. PLOT
// =============================================================================
plot(showEmas ? emaFast : na, "EMA 50", color = color.new(color.orange, 20), linewidth = 1)
plot(showEmas ? emaSlow : na, "EMA 200", color = color.new(#2962ff, 20), linewidth = 2)
plot(trDir != 0 ? trSL : na, "SL berjalan", color = color.new(colBear, 40), linewidth = 1, style = plot.style_linebr)
plot(trDir != 0 ? trTP1 : na, "TP1", color = color.new(colBull, 60), linewidth = 1, style = plot.style_linebr)
plot(trDir != 0 ? trTP2 : na, "TP2", color = color.new(colBull, 40), linewidth = 1, style = plot.style_linebr)

// =============================================================================
//  7. PANEL STATISTIK BACKTEST
// =============================================================================
panelPos = panelPosInp == "Kanan Atas" ? position.top_right : panelPosInp == "Kanan Bawah" ? position.bottom_right : panelPosInp == "Kiri Atas" ? position.top_left : position.bottom_left

var table panel = table.new(panelPos, 2, 12, bgcolor = color.new(#131722, 15), border_width = 1, border_color = color.new(color.gray, 75), frame_width = 1, frame_color = color.new(color.gray, 60))

if showPanel and barstate.islast
    color cTrend = trendDir == 1 ? colBull : trendDir == -1 ? colBear : color.gray
    float winrate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : na
    float pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    float expectancy = strategy.closedtrades > 0 ? strategy.netprofit / strategy.closedtrades : na
    float netPct = strategy.netprofit / strategy.initial_capital * 100
    string posTxt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    table.cell(panel, 0, 0, "SZT STRATEGY", text_color = color.white, text_size = size.small, bgcolor = color.new(#131722, 0))
    table.cell(panel, 1, 0, masterEnable ? "v1 • ON" : "v1 • OFF", text_color = masterEnable ? colBull : colBear, text_size = size.small, bgcolor = color.new(#131722, 0))
    table.cell(panel, 0, 1, "Trend", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 1, trendText, text_color = cTrend, text_size = size.tiny)
    table.cell(panel, 0, 2, "Posisi", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 2, posTxt, text_color = strategy.position_size > 0 ? colBull : strategy.position_size < 0 ? colBear : color.white, text_size = size.tiny)
    table.cell(panel, 0, 3, "Entry / SL", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 3, trDir == 0 ? "-" : str.tostring(trEntry, format.mintick) + " / " + str.tostring(trSL, format.mintick), text_color = color.white, text_size = size.tiny)
    table.cell(panel, 0, 4, "TP1 / TP2", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 4, trDir == 0 ? "-" : str.tostring(trTP1, format.mintick) + " / " + str.tostring(trTP2, format.mintick), text_color = colBull, text_size = size.tiny)
    table.cell(panel, 0, 5, "Equity", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 5, str.tostring(strategy.equity, "#.##"), text_color = color.white, text_size = size.tiny)
    table.cell(panel, 0, 6, "Net profit", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 6, str.tostring(netPct, "#.##") + " %", text_color = netPct >= 0 ? colBull : colBear, text_size = size.tiny)
    table.cell(panel, 0, 7, "Winrate", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 7, na(winrate) ? "-" : str.tostring(winrate, "#.#") + " %", text_color = color.white, text_size = size.tiny)
    table.cell(panel, 0, 8, "Profit factor", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 8, na(pf) ? "-" : str.tostring(pf, "#.##"), text_color = color.white, text_size = size.tiny)
    table.cell(panel, 0, 9, "Expectancy/trade", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 9, na(expectancy) ? "-" : str.tostring(expectancy, "#.##"), text_color = color.white, text_size = size.tiny)
    table.cell(panel, 0, 10, "Total trades", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 10, str.tostring(strategy.closedtrades), text_color = color.white, text_size = size.tiny)
    table.cell(panel, 0, 11, "Sinyal hari ini", text_color = color.silver, text_size = size.tiny)
    table.cell(panel, 1, 11, str.tostring(signalsToday) + " / " + str.tostring(maxSignalsDay), text_color = signalsToday >= maxSignalsDay ? colBear : color.white, text_size = size.tiny)
